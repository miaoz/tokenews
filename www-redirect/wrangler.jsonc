{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Sends www.tokenews.xyz to the primary domain, keeping path and query.
  // A separate Worker so the main site stays pure static assets.
  "name": "tokenews-www",
  "main": "index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "routes": [{ "pattern": "www.tokenews.xyz", "custom_domain": true }]
}
